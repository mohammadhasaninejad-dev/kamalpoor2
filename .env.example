# پلتفرم: telegram  یا  bale
PLATFORM=telegram

# توکن بازو
# تلگرام: از @BotFather
# بله: از @botfather داخل بله (ble.ir/botfather)
BOT_TOKEN=123456:ABC-DEF...

# آدرس پایه API (معمولاً لازم نیست دستی تنظیم شود)
# telegram → https://api.telegram.org
# bale     → https://tapi.bale.ai
# API_BASE=https://tapi.bale.ai

# آدرس عمومی همین سرویس (برای مینی‌اپ اسکنر) — بعد از دیپلوی پر کنید
WEBAPP_URL=https://your-app-name.up.railway.app

# آیدی عددی ادمین‌ها (با ویرگول جدا کنید)
# داخل بات دستور /myid را بزنید تا آیدی‌تان را ببینید
ADMIN_IDS=69947192,98546496

# مسیر دیتابیس — روی Railway حتماً Volume دائمی بسازید
DATABASE_PATH=data/products.db
# مثال Railway: DATABASE_PATH=/data/products.db

PAGE_SIZE=10
